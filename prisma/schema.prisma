// MyReply: B2B Instagram comment-to-DM SaaS schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Which workspace this user is currently acting in. Null means fall back to
  // their oldest membership. This is a preference, never a grant: every read
  // re-checks WorkspaceMember, so a stale or revoked id gives no access.
  activeWorkspaceId String?

  /// When this person accepted the Terms and the Privacy Policy, and which
  /// version they saw.
  ///
  /// Nothing recorded that anyone had ever agreed to anything. The login form
  /// shows the notice, but a notice nobody stored is not a record: in a
  /// dispute there was no answer to "when did they accept, and to what".
  ///
  /// Stamped at account creation, because that is the moment they submitted
  /// the form carrying the notice. Nullable because every account that existed
  /// before this column did not go through that, and backfilling a date would
  /// be inventing evidence.
  termsAcceptedAt DateTime?
  termsVersion    String?

  accounts         Account[]
  sessions         Session[]
  ownedWorkspaces  Workspace[]           @relation("WorkspaceOwner")
  workspaceMembers WorkspaceMember[]
  sentInvitations  WorkspaceInvitation[] @relation("WorkspaceInvitationsSent")
  activeWorkspace  Workspace?            @relation("UserActiveWorkspace", fields: [activeWorkspaceId], references: [id], onDelete: SetNull)
  createdApiKeys   ApiKey[]              @relation("ApiKeyCreatedBy")

  oauthAuthorizationCodes OAuthAuthorizationCode[]
  oauthTokens             OAuthToken[]
}

/// A machine credential scoped to one workspace, for the public API and for
/// embedding MyReply inside another product. Only the SHA-256 hash is stored,
/// so a leaked database row cannot be replayed as a key. `prefix` is the
/// human-readable head of the key, kept solely so the UI can tell keys apart.
model ApiKey {
  id              String        @id @default(cuid())
  workspaceId     String
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name            String
  prefix          String
  hashedKey       String        @unique
  /// The workspace role this key acts with. Reuses the same RBAC ladder as a
  /// human member, so canManageWorkspace applies unchanged.
  role            WorkspaceRole @default(ADMIN)
  /// What the key may do, from lib/api/scopes.ts, cut to its role on every
  /// call. Empty means everything the role allows, which is what every key
  /// made before scopes existed keeps.
  scopes          String[]      @default([])
  createdByUserId String?
  createdBy       User?         @relation("ApiKeyCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lastUsedAt      DateTime?
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([workspaceId])
  @@index([createdByUserId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  /// Null for a workspace a partner app created for one of its own users:
  /// nobody signs in to it here, the partner acts on it with its key.
  ownerId   String?
  owner     User?    @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The partner app that created this workspace, which alone may act on it
  /// with a partner key. Restrict, so removing a partner can never take its
  /// customers' workspaces with it by accident.
  partnerId  String?
  partner    Partner? @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  /// The partner's own id for the user this workspace belongs to.
  externalId String?

  /// FREE gets everything with no marginal cost. PRO adds managed AI and
  /// advanced flows. BYOK AI is free on both: the key is the customer's.
  plan WorkspacePlan @default(FREE)

  /// The one voice decision the owner ever makes. Every message this product
  /// suggests is written in this tone, so the question is asked once and then
  /// inherited by every campaign after it. Changeable later, never blank.
  /// The suggestion library keys off lowercase ids, see lib/suggestions/tone.ts.
  tone WorkspaceTone @default(FRIENDLY)

  /// The workspace's own IANA timezone, and the quiet window inside it.
  ///
  /// This is the closest proxy the data has for the audience's clock: an
  /// account's followers cluster around the account's own hours, and it is the
  /// only timezone the owner ever sets or sees.
  ///
  /// It gates FOLLOW-UPS ONLY. A campaign's first reply is never held: someone
  /// commented asking for the link, they are awake because they just
  /// commented, and making them wait until morning breaks the one thing the
  /// product promises. A follow-up is the message that lands at 3am unasked.
  timezone          String  @default("UTC")
  quietHoursEnabled Boolean @default(true)
  /// Local hour quiet begins. The default window wraps midnight, 21 to 9.
  quietHoursStart   Int     @default(21)
  /// Local hour quiet ends.
  quietHoursEnd     Int     @default(9)

  usagePeriodStart  DateTime @default(now())
  dmsSentThisPeriod Int      @default(0)

  members           WorkspaceMember[]
  invitations       WorkspaceInvitation[]
  instagramAccounts InstagramAccount[]
  automations       Automation[]
  dmLogs            DmLog[]
  trackedLinks      TrackedLink[]
  linkClicks        LinkClick[]
  webhookEvents     WebhookEvent[]
  operationalEvents OperationalEvent[]
  activeForUsers    User[]                 @relation("UserActiveWorkspace")
  apiKeys           ApiKey[]
  contacts          Contact[]
  tags              Tag[]
  knowledgeSources  KnowledgeSource[]
  flows             Flow[]
  flowRuns          FlowRun[]
  conversions       Conversion[]
  assistantAnswers  AssistantAnswer[]
  outboundMessages  OutboundMessage[]
  aiCredential      WorkspaceAiCredential?
  usageDays         UsageDaily[]

  oauthAuthorizationCodes OAuthAuthorizationCode[]
  oauthTokens             OAuthToken[]

  @@unique([partnerId, externalId])
  @@index([ownerId])
  @@index([partnerId, createdAt])
}

/// An app that embeds the engine for its own users. Lash Tech is the first.
///
/// It creates one workspace per user of its own and acts on them with a
/// partner key. It never sees a workspace it did not create. The branding is
/// what the hosted connect and inbox pages show in place of this product's
/// name, so an end user only ever sees the partner.
model Partner {
  id            String        @id @default(cuid())
  /// Internal label, never shown to an end user.
  name          String
  brandName     String
  logoUrl       String?
  primaryColor  String        @default("#111827")
  accentColor   String        @default("#2563EB")
  /// Whether hosted pages say who runs them underneath. Off unless the
  /// partner asks for it.
  showPoweredBy Boolean       @default(false)
  /// The sender for email sent on the partner's behalf. Its domain must be
  /// verified with the mail provider first.
  emailFromName    String?
  emailFromAddress String?
  /// A hostname of the partner's that serves the hosted pages, such as
  /// connect.lashtech.app. Null serves them from this deployment's own domain.
  customDomain  String?       @unique
  /// Origins that may frame the hosted pages, such as https://lashtech.app.
  frameOrigins  String[]      @default([])
  /// Origins a connect link may send the person back to.
  returnOrigins String[]      @default([])
  /// The plan the partner's workspaces are created on.
  workspacePlan WorkspacePlan @default(FREE)
  disabledAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  keys       PartnerApiKey[]
  workspaces Workspace[]
}

/// A partner's machine credential. Hashed at rest exactly like an API key.
/// Acting on a workspace takes the workspace id in a header, and only one of
/// the partner's own workspaces is ever accepted.
model PartnerApiKey {
  id         String    @id @default(cuid())
  partnerId  String
  partner    Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name       String
  prefix     String
  hashedKey  String    @unique
  /// From lib/api/scopes.ts. Empty means every scope.
  scopes     String[]  @default([])
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([partnerId])
}

/// A person the account has talked to, identified once rather than repeated on
/// every log row. Until this existed there was no record of a human across
/// conversations, which is what tags, segments, broadcasts and data collection
/// all need to hang on.
///
/// Scoped to a connected account, not to the workspace: the same person
/// messaging two of an agency's clients is two contacts, because the platform
/// ids are per-account and one client must not see the other's audience.
model Contact {
  id                 String    @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  /// The platform-scoped user id. Unique per connected account, never global.
  externalId         String
  username           String?
  name               String?
  firstSeenAt        DateTime  @default(now())
  lastSeenAt         DateTime  @default(now())
  /// Denormalised so a contact list does not aggregate DmLog on every render.
  dmCount            Int       @default(0)
  lastDmAt           DateTime?
  /// Set when this person replied STOP, or one of the words people actually
  /// use for it. Every automated send path checks this. Cleared if they later
  /// reply START.
  ///
  /// Scoped to the contact, and a contact belongs to one Instagram account, so
  /// telling one brand to stop does not opt them out of another workspace's
  /// messages. Different senders; they only asked one of them.
  optedOutAt         DateTime?
  /// The last time this person wrote to the account, tapped one of its
  /// buttons or arrived through one of its links. It is what opens the
  /// platform's messaging window, so every automated message checks it. A
  /// comment does not set it: a comment opens one private reply, not a
  /// conversation. Null on rows from before it was recorded.
  lastInboundAt      DateTime?
  /// The email or phone number this person shared by tapping a campaign's
  /// capture button. The proof of what they agreed to, and when, is the
  /// ContactConsent row; these are the current values for display and export.
  email              String?
  phone              String?
  /// Positive reactions this person has placed on messages we delivered.
  /// Only "react" moves this; an "unreact" is a withdrawal, not a signal, so
  /// it is deliberately not recorded and never decrements. Segmentation asks
  /// "has this person ever reacted", which an unreact does not undo.
  reactionCount      Int       @default(0)
  lastReactionAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount  @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  tags             ContactTag[]
  dmLogs           DmLog[]
  linkClicks       LinkClick[]
  assistantAnswers AssistantAnswer[]
  flowRuns         FlowRun[]
  conversions      Conversion[]
  outboundMessages OutboundMessage[]
  consents         ContactConsent[]

  @@unique([instagramAccountId, externalId])
  @@index([workspaceId])
  @@index([instagramAccountId])
  @@index([workspaceId, lastSeenAt])
}

/// A label the workspace defines. Tags are workspace-wide so the same label can
/// be applied across every client account the workspace manages.
model Tag {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  /// Optional swatch for the UI. Null renders in the neutral token.
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts  ContactTag[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

/// Join row. Carries its own timestamp so "tagged in the last 7 days" is a
/// answerable question without a separate audit table.
model ContactTag {
  contactId String
  tagId     String
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tagId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id              String                    @id @default(cuid())
  workspaceId     String
  email           String
  role            WorkspaceRole             @default(MEMBER)
  token           String                    @unique
  status          WorkspaceInvitationStatus @default(PENDING)
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("WorkspaceInvitationsSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([email])
  @@index([workspaceId])
  @@index([status])
}

/// A connected messaging account on any platform.
///
/// Named InstagramAccount because Instagram was the only platform when it was
/// created. `platform` says which one it is, and `instagramId` holds the
/// platform's own id for the account, whatever the platform. The rename to a
/// neutral name waits until a second platform's rows exist, so it can be done
/// once, with data, rather than guessed at.
model InstagramAccount {
  id                String    @id @default(cuid())
  workspaceId       String
  platform          ChannelPlatform @default(INSTAGRAM)
  instagramId       String    @unique
  username          String
  name              String?
  accessToken       String
  tokenExpiresAt    DateTime?
  webhookSubscribed Boolean   @default(false)
  /// The platform's app-scoped id for the person who granted this connection.
  /// It is the id Meta names when that person removes the app or asks for
  /// their data to be deleted. Null on rows connected before it was recorded.
  authorizedByExternalId String?
  connectedAt       DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automations       Automation[]
  dmLogs            DmLog[]
  linkClicks        LinkClick[]
  followerSnapshots FollowerSnapshot[]
  contacts          Contact[]
  capturePrompts    CapturePrompt[]
  outboundMessages  OutboundMessage[]

  @@index([workspaceId])
  @@index([platform, authorizedByExternalId])
}

/// Daily follower total for one account. Instagram only retains ~30 days of
/// account insights, so history beyond that window exists only because we
/// record it here. One row per account per day.
model FollowerSnapshot {
  id                 String   @id @default(cuid())
  instagramAccountId String
  /// Midnight UTC of the day this count belongs to.
  date               DateTime @db.Date
  followersCount     Int
  /// True when the row was reconstructed from follower_count insight deltas
  /// rather than observed directly, so it can be corrected later.
  backfilled         Boolean  @default(false)
  createdAt          DateTime @default(now())

  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([instagramAccountId, date])
  @@index([instagramAccountId, date])
}

model Automation {
  id                 String @id @default(cuid())
  workspaceId        String
  instagramAccountId String

  name                 String
  goal                 String?
  postId               String?
  postUrl              String?
  pendingNextReel      Boolean  @default(false)
  matchAnyPost         Boolean  @default(false)
  keywords             String[]
  matchAnyWord         Boolean  @default(false)
  // Also fire this campaign when someone sends a DM whose text matches the
  // keywords above. Independent of the post trigger, a DM has no media, so
  // postId / matchAnyPost do not apply to it.
  dmTriggerEnabled     Boolean  @default(false)
  // Fire when someone replies to one of your stories with matching text.
  // Instagram delivers this as a message, so keywords still apply.
  storyReplyEnabled    Boolean  @default(false)
  // Fire when someone mentions you in their story. There is no text to match
  // on, so the mention itself is the trigger and keywords are ignored.
  storyMentionEnabled  Boolean  @default(false)
  // Fire on matching comments during an Instagram Live broadcast.
  liveCommentEnabled   Boolean  @default(false)
  // Answer inbound DMs that matched no other campaign. At most one per
  // account should carry this, and it is only consulted after every keyword
  // campaign has declined the message.
  defaultReplyEnabled  Boolean  @default(false)
  // Fire when someone opens a conversation through a link, QR code or website
  // button carrying this exact ref. Null means the campaign has no ref entry.
  referralRef          String?
  dmMessage            String
  openingDmEnabled     Boolean  @default(false)
  openingDmMessage     String?
  openingDmButtonLabel String?
  linkButtonLabel      String?

  /// Tappable quick replies carried by this campaign's DM, as a JSON array of
  /// { title, type: "text" | "email" | "phone", payload }. Instagram shows at
  /// most 13 and truncates a title at 20 characters. "email" and "phone" are
  /// prefilled from the tapper's own profile, so they capture a contact detail
  /// in one tap and carry no payload; a "text" button's payload names the
  /// follow-up to send, and is routed through the same postback handler as an
  /// opening DM button (for example `reveal:<campaign id>`).
  quickRepliesEnabled Boolean @default(false)
  quickReplies        Json?

  /// A publicly reachable image, video or PDF sent alongside the DM.
  /// Instagram fetches the URL itself, so anything behind auth, or a signed
  /// URL that expires, fails on Meta's side rather than ours.
  attachmentUrl           String?
  requireFollow           Boolean  @default(false)
  followPromptMessage     String?
  followPromptButtonLabel String?
  followUpEnabled         Boolean  @default(false)
  followUpMessage         String?
  // Minutes to wait after the link is delivered before sending the follow-up.
  // 0 sends it right away.
  followUpDelayMinutes    Int      @default(0)
  publicReplyEnabled      Boolean  @default(false)
  publicReplyMessage      String?
  publicReplyMessages     String[] @default([])
  /// Ask for an email or phone number after the campaign's message. Sent as
  /// its own message, with the platform's one-tap email and phone buttons,
  /// only where the person has already written to the account. captureKinds
  /// holds "email" and/or "phone". The consent wording is shown under the ask
  /// and stored, word for word, with every detail collected.
  captureEnabled          Boolean  @default(false)
  captureKinds            String[] @default([])
  capturePrompt           String?
  captureConsentText      String?
  isActive                Boolean  @default(true)
  wholeWordMatch          Boolean  @default(true)
  reportShareSlug         String?  @unique
  reportShareEnabled      Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  dmLogs           DmLog[]
  trackedLinks     TrackedLink[]
  linkClicks       LinkClick[]
  conversions      Conversion[]
  capturePrompts   CapturePrompt[]
  consents         ContactConsent[]

  @@index([workspaceId])
  @@index([instagramAccountId])
  @@index([postId])
}

model DmLog {
  id                 String @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String

  commenterId    String
  commenterName  String?
  /// Set once the contact layer resolves the recipient. Nullable because rows
  /// written before contacts existed have no link, and a failed send may have
  /// no resolvable person at all.
  contactId      String?
  commentText    String
  commentId      String
  matchedKeyword String?
  status         DmStatus  @default(PENDING)
  attempts       Int       @default(0)
  dmSentAt       DateTime?
  errorMessage   String?

  // The public comment reply is delivered independently of the DM, so its
  // outcome is tracked separately. publicReplySentAt makes it idempotent across
  // retries; a DM failure never blocks or re-posts the public reply.
  dmDeliveryUnconfirmed Boolean @default(false)
  publicReplyDeliveryUnconfirmed Boolean @default(false)
  publicReplySentAt DateTime?
  publicReplyError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation        @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount  @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  contact          Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  outboundMessages OutboundMessage[]

  @@unique([automationId, commentId])
  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([status])
}

/// A message the connected account sent, as Instagram echoed it back.
///
/// This is deliberately NOT DmLog. DmLog is automation-scoped by construction:
/// `automationId` is a required foreign key and the row is keyed
/// `@@unique([automationId, commentId])`. A reply an operator typed into the
/// Instagram app belongs to no campaign, so storing it there would mean making
/// automationId nullable, which breaks that unique key and every report,
/// portal and analytics query that assumes a DmLog row means "a campaign did
/// this". Outbound messages are a different fact, so they get their own table.
///
/// Keyed on Meta's `messageId`, which is one per real message. That is what
/// makes recording an echo idempotent: Meta redelivers webhooks, and a
/// redelivery finds the row already there rather than writing a second one.
model OutboundMessage {
  id                 String                @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  /// Null when the recipient could not be resolved to a Contact. Recording the
  /// message still matters more than the link.
  contactId          String?
  /// IGSID of the person the message went to.
  recipientId        String
  /// Meta's message id. Unique, so an echo can only ever be recorded once.
  messageId          String                @unique
  text               String
  source             OutboundMessageSource @default(MANUAL)
  /// The DmLog row this echo belongs to, when MyReply sent it. Set so a
  /// timeline that reads both tables can show one message rather than two.
  dmLogId            String?
  sentAt             DateTime
  createdAt          DateTime              @default(now())

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  contact          Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dmLog            DmLog?           @relation(fields: [dmLogId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([instagramAccountId])
  @@index([contactId])
  @@index([dmLogId])
  @@index([instagramAccountId, recipientId, sentAt])
}

// Legacy reconciliation model; currently unwired. Runtime code does not read
// or write ProcessedComment. Current reconciliation dedup uses owner-reply
// checks and DmLog guards instead.
model ProcessedComment {
  id                 String   @id @default(cuid())
  instagramAccountId String
  commentId          String   @unique
  source             String // "WEBHOOK" | "POLLING"
  seenAt             DateTime @default(now())

  @@index([instagramAccountId])
}

model TrackedLink {
  id             String   @id @default(cuid())
  workspaceId    String
  automationId   String
  slug           String   @unique
  label          String?
  destinationUrl String
  // Which DM button this link is, starting at 0. Read links with
  // TRACKED_LINK_ORDER (lib/tracking/link-order.ts), never by createdAt alone:
  // links saved in one request share a createdAt, and Postgres returns tied
  // rows in no fixed order.
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)
  clicks     LinkClick[]

  @@index([workspaceId])
  @@index([automationId])
}

model LinkClick {
  id                 String   @id @default(cuid())
  /// Who clicked. Null on rows written before per-recipient links existed, and
  /// on any click whose token did not resolve.
  contactId          String?
  /// The per-recipient token the link carried. One campaign used to hand every
  /// recipient the same URL, so a click could never be traced to a person.
  clickToken         String?
  workspaceId        String
  automationId       String
  instagramAccountId String
  trackedLinkId      String
  ipHash             String?
  // Token from the link's `?r=` (hashRecipientId), set on links sent in a DM.
  // Clicks are counted once per recipient, falling back to ipHash without it.
  recipientHash      String?
  userAgent          String?
  referrer           String?
  createdAt          DateTime @default(now())

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  trackedLink      TrackedLink      @relation(fields: [trackedLinkId], references: [id], onDelete: Cascade)
  contact          Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversions      Conversion[]

  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([trackedLinkId])
  @@index([contactId])
  @@index([clickToken])
  @@index([createdAt])
  @@index([workspaceId, createdAt])
}

model WebhookEvent {
  id           String        @id @default(cuid())
  workspaceId  String?
  object       String?
  payload      Json
  status       WebhookStatus @default(PENDING)
  errorMessage String?
  createdAt    DateTime      @default(now())
  processedAt  DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([status])
}

model OperationalEvent {
  id          String                 @id @default(cuid())
  workspaceId String?
  source      OperationalEventSource
  level       OperationalEventLevel  @default(INFO)
  message     String
  payload     Json?
  createdAt   DateTime               @default(now())
  resolvedAt  DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([source])
  @@index([level])
  @@index([createdAt])
}

/// One workspace's own AI provider credential. MyReply is bring your own key:
/// Ask MyReply runs on this key and the tokens are billed to the workspace's
/// own provider account. There is no shared MyReply key to fall back to, which
/// is deliberate, a tenant can never spend another tenant's balance.
///
/// The secret is AES-256-GCM ciphertext under the same ENCRYPTION_KEY that
/// protects Meta tokens, and it is never returned to a client once saved, not
/// even to the owner who typed it. `keyHint` is a masked head and tail, enough
/// for the UI to say which key is configured and useless to anyone who reads
/// the row.
model WorkspaceAiCredential {
  id              String     @id @default(cuid())
  workspaceId     String     @unique
  workspace       Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider        AiProvider
  encryptedKey    String
  keyHint         String
  model           String
  /// Audit stamp only. Deliberately not a foreign key: it records who set the
  /// key rather than granting anything, so it should outlive the user row.
  createdByUserId String?
  lastUsedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

/// Who actually sent an outbound message. AUTOMATION means MyReply sent it and
/// a DmLog row already accounts for it; MANUAL means a human sent it from the
/// Instagram app or anywhere else outside MyReply.
enum OutboundMessageSource {
  AUTOMATION
  MANUAL
}

/// Mirrored by CHANNEL_PLATFORMS in lib/channels/platforms.ts; the channel
/// registry fails to compile if the two drift apart.
enum ChannelPlatform {
  INSTAGRAM
  FACEBOOK
}

enum AiProvider {
  ANTHROPIC
  OPENROUTER
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DmStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_DEDUP
  SKIPPED_RATE_LIMIT
  SKIPPED_PLAN_LIMIT
  SKIPPED_NO_MATCH
  /// The recipient replied STOP. Distinct from the other skips because it is
  /// the one an owner may be asked to account for.
  SKIPPED_OPTED_OUT
  /// The platform's messaging rules would refuse the send: a comment past its
  /// private-reply window, or a person who has not written in 24 hours.
  SKIPPED_WINDOW_CLOSED
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
}

enum OperationalEventSource {
  WORKER
  TOKEN_REFRESH
  HEALTH
  SYSTEM
}

enum OperationalEventLevel {
  INFO
  WARNING
  ERROR
}

/// A source of truth the assistant may answer customers from.
///
/// Ingest is the axis the competition is weakest on: ManyChat takes one URL per
/// entry with no crawl and no PDF, and Chatfuel is a hand-typed form. A source
/// here can be a crawled site, an uploaded document, or a hand written answer,
/// and a crawled source can re-sync on a schedule.
model KnowledgeSource {
  id             String              @id @default(cuid())
  workspaceId    String
  kind           KnowledgeSourceKind
  /// Display name. For a crawl this defaults to the hostname.
  title          String
  /// Crawl root for WEBSITE, original filename for DOCUMENT, null for MANUAL.
  url            String?
  /// How deep a crawl follows links from the root. Ignored by other kinds.
  crawlDepth     Int                 @default(1)
  status         KnowledgeStatus     @default(PENDING)
  /// Why the last ingest failed, shown to the operator rather than swallowed.
  errorMessage   String?
  lastSyncedAt   DateTime?
  /// Null means never re-sync. Set for crawls the operator wants kept fresh.
  syncEveryHours Int?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chunks    KnowledgeChunk[]

  @@index([workspaceId])
  @@index([status])
}

/// One retrievable passage. Chunking happens at ingest so answering never pays
/// to split a document, and so a citation can point at the exact passage used.
model KnowledgeChunk {
  id        String                      @id @default(cuid())
  sourceId  String
  /// Position within the source, so neighbouring chunks can be stitched back.
  ordinal   Int
  content   String
  /// Where this passage came from, for the citation shown under an answer.
  citation  String?
  /// gte-small embedding of `content`, 384 dimensions, produced by the
  /// supabase/functions/embed Edge Function. Prisma has no native vector type,
  /// so it is declared Unsupported: the client can neither select nor filter
  /// it, which is why lib/ai/retrieval.ts and lib/ai/embeddings.ts reach it
  /// through raw SQL. Everything else about this model is unaffected, and an
  /// Unsupported column is left out of the default selection set, so existing
  /// queries and `createMany` keep working untouched.
  ///
  /// Nullable, and it has to stay nullable. Chunks ingested before this column
  /// existed have no vector and must keep retrieving through BM25, and an
  /// ingest that runs while the embedder is unreachable has to be able to store
  /// its passages anyway.
  embedding Unsupported("vector(384)")?
  createdAt DateTime                    @default(now())

  source KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
}

/// Every answer the assistant gave a real customer, kept so a human can correct
/// it. Only Tidio ships a loop like this; ManyChat's feedback goes to ManyChat
/// rather than into your knowledge base.
model AssistantAnswer {
  id                 String         @id @default(cuid())
  workspaceId        String
  instagramAccountId String?
  contactId          String?
  question           String
  answer             String
  /// 0 to 1. Below the workspace threshold the answer is not sent.
  confidence         Float
  /// True when the assistant declined and the conversation went to a human.
  handedOff          Boolean        @default(false)
  /// Set by a human reviewing the answer. Null means unreviewed.
  verdict            AnswerVerdict?
  /// The corrected answer a human supplied. Fed back as a MANUAL source.
  correction         String?
  /// The model that wrote the answer, and what the call consumed. Null when no
  /// model was called (a decline before generation) or the provider did not
  /// say. Cost is in millionths of a dollar, so money is never a float.
  model              String?
  inputTokens        Int?
  outputTokens       Int?
  costMicros         Int?
  createdAt          DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, verdict])
}

enum KnowledgeSourceKind {
  WEBSITE
  DOCUMENT
  MANUAL
}

enum KnowledgeStatus {
  PENDING
  READY
  FAILED
}

enum AnswerVerdict {
  GOOD
  WRONG
}

enum WorkspacePlan {
  FREE
  PRO
}

/// The voice every suggested message is written in. Mirrored as lowercase ids
/// in lib/suggestions/types.ts, which is what the UI and the message library
/// use. lib/suggestions/tone.ts owns the mapping between the two and will fail
/// to compile if this enum and that list ever drift apart.
enum WorkspaceTone {
  FRIENDLY
  PROFESSIONAL
  HYPE
  SHORT
  WARM
}

/// How an OAuth client came to exist. DYNAMIC is RFC 7591 dynamic client
/// registration, which is what Claude and ChatGPT use today. METADATA_DOCUMENT
/// is a Client ID Metadata Document: the client_id is itself an https URL whose
/// JSON document we fetch and re-read periodically, so nothing is registered.
enum OAuthClientRegistration {
  DYNAMIC
  METADATA_DOCUMENT
}

enum OAuthTokenType {
  ACCESS
  REFRESH
}

/// An MCP client that may ask a MyReply user for access.
///
/// Deliberately holds no client secret. Every client here is a public client
/// that must use PKCE, which is what MCP clients are in practice, and it means
/// there is no shared secret to leak, rotate or accidentally log.
model OAuthClient {
  id String @id @default(cuid())

  /// The public identifier. A generated `mrc_...` for a dynamically registered
  /// client, or the https URL of the metadata document for the other kind.
  clientId     String                  @unique
  registration OAuthClientRegistration @default(DYNAMIC)

  clientName              String
  clientUri               String?
  logoUri                 String?
  /// Matched exactly at authorize time. No prefixes, no wildcards.
  redirectUris            String[]
  /// The most this client may ever be granted, space separated.
  scope                   String   @default("mcp:read mcp:write")
  grantTypes              String[]
  responseTypes           String[]
  tokenEndpointAuthMethod String   @default("none")

  /// When the metadata document was last read. Null for a registered client.
  metadataFetchedAt DateTime?
  /// Set to stop a client without losing the record of what it did.
  disabledAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorizationCodes OAuthAuthorizationCode[]
  tokens             OAuthToken[]

  @@index([registration])
}

/// A one-time authorization code. Short lived, single use, and bound to the
/// PKCE challenge, the redirect_uri, the scope, the resource, the user and the
/// workspace it was approved for. Only the SHA-256 of the code is stored, the
/// same discipline API keys use, so a dumped row cannot be redeemed.
model OAuthAuthorizationCode {
  id         String @id @default(cuid())
  hashedCode String @unique

  clientRecordId String
  client         OAuthClient @relation(fields: [clientRecordId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  redirectUri         String
  scope               String
  /// RFC 8707 resource indicator. The audience every token minted from this
  /// code is bound to.
  resource            String
  codeChallenge       String
  codeChallengeMethod String @default("S256")

  expiresAt  DateTime
  /// Stamped the first time the code is redeemed. A second redemption finds
  /// this set, fails, and revokes everything the first redemption issued.
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  tokens OAuthToken[]

  @@index([clientRecordId])
  @@index([userId])
  @@index([workspaceId])
  @@index([expiresAt])
}

/// An access or refresh token. Hashed at rest exactly like an API key, and
/// audience bound through `resource` so a token minted for another server is
/// refused here rather than quietly accepted.
model OAuthToken {
  id          String         @id @default(cuid())
  type        OAuthTokenType
  hashedToken String         @unique

  clientRecordId String
  client         OAuthClient @relation(fields: [clientRecordId], references: [id], onDelete: Cascade)

  /// The code this grant started from. Used as the family id: a replayed code
  /// or a reused refresh token revokes every token sharing it.
  authorizationCodeId String?
  authorizationCode   OAuthAuthorizationCode? @relation(fields: [authorizationCodeId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  scope    String
  resource String

  expiresAt  DateTime
  /// Refresh tokens only: when this one was spent on a rotation. Presenting a
  /// spent token again is reuse, and revokes the whole family.
  usedAt     DateTime?
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([clientRecordId])
  @@index([userId])
  @@index([workspaceId])
  @@index([authorizationCodeId])
  @@index([type, expiresAt])
}

/// A multi-step automation: trigger, conditions, actions.
///
/// Kept as a versioned JSON graph rather than a table per node type, because
/// the shape changes as node types are added and a run must keep executing the
/// definition it started with. `definition` is validated against a Zod schema
/// on write, so the looseness is at rest rather than in the code.
model Flow {
  id          String      @id @default(cuid())
  workspaceId String
  name        String
  trigger     FlowTrigger
  isActive    Boolean     @default(false)
  /// The node graph. Validated on write, never trusted on read.
  definition  Json
  /// Bumped on every save. A run records which version it executed.
  version     Int         @default(1)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs      FlowRun[]

  @@index([workspaceId])
  @@index([workspaceId, trigger, isActive])
}

/// One execution. Durable, because a flow can wait inside the 24 hour window
/// and the worker restarting must not lose where it was.
model FlowRun {
  id           String        @id @default(cuid())
  flowId       String
  workspaceId  String
  /// Which definition version ran, so an edit mid-run cannot change the rules
  /// under a person who is already partway through.
  version      Int
  contactId    String?
  status       FlowRunStatus @default(RUNNING)
  /// Set while a wait step is pending, so the resume cron knows when to look.
  resumeAt     DateTime?
  /// Where execution is, so a resume does not restart from the top.
  cursorStepId String?
  errorMessage String?
  startedAt    DateTime      @default(now())
  finishedAt   DateTime?

  flow      Flow          @relation(fields: [flowId], references: [id], onDelete: Cascade)
  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  steps     FlowStepLog[]

  @@index([workspaceId, startedAt])
  @@index([status, resumeAt])
  @@index([flowId])
}

/// What each step did, including what it declined to do and why. An operator
/// cannot tell a skip from a failure on an empty screen.
model FlowStepLog {
  id           String         @id @default(cuid())
  runId        String
  stepId       String
  kind         String
  status       FlowStepStatus
  /// Redacted at write time. Never store a credential here.
  detail       Json?
  errorMessage String?
  at           DateTime       @default(now())

  run FlowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, at])
}

/// Money, or a booking, attributed back to the DM that caused it.
///
/// The chain is comment, DM, click, conversion. Until this existed the chain
/// stopped at an anonymous click, so a campaign could report 43 clicks and
/// never who, or what happened next.
model Conversion {
  id           String           @id @default(cuid())
  workspaceId  String
  automationId String?
  contactId    String?
  linkClickId  String?
  /// Minor units, so there is no float anywhere near money.
  valueCents   Int              @default(0)
  currency     String           @default("USD")
  source       ConversionSource
  /// The provider's own id, so a replayed webhook cannot double count.
  externalId   String?
  createdAt    DateTime         @default(now())

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation Automation? @relation(fields: [automationId], references: [id], onDelete: SetNull)
  contact    Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  linkClick  LinkClick?  @relation(fields: [linkClickId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, source, externalId])
  @@index([workspaceId, createdAt])
  @@index([automationId])
  @@index([contactId])
}

enum FlowTrigger {
  COMMENT
  DM_KEYWORD
  STORY_REPLY
  STORY_MENTION
  LIVE_COMMENT
  REFERRAL
  QUICK_REPLY
  REACTION
  MENTION
}

enum FlowRunStatus {
  RUNNING
  WAITING
  DONE
  FAILED
  /// Stopped because continuing would have broken a platform rule, most often
  /// the 24 hour messaging window closing mid-run.
  ABANDONED
}

enum FlowStepStatus {
  DONE
  SKIPPED
  FAILED
  WAITING
}

enum ConversionSource {
  SQUARE
  WEBHOOK
  MANUAL
}

// Claims persist independently of BullMQ retention so old taps never resend.
model PostbackDelivery {
  id String @id
  createdAt DateTime @default(now())
}

enum ContactDetailKind {
  EMAIL
  PHONE
}

/// A capture ask the engine sent: who it went to, which details it offered
/// and the consent wording exactly as shown. A tap on an email or phone button
/// is only recorded against one of these, so a detail is never stored without
/// the words the person saw when they shared it. Kept for 30 days.
model CapturePrompt {
  id                  String              @id @default(cuid())
  workspaceId         String
  instagramAccountId  String
  automationId        String?
  /// The platform-scoped id of the person it was sent to.
  recipientExternalId String
  kinds               ContactDetailKind[]
  consentText         String
  sentAt              DateTime            @default(now())

  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  automation       Automation?      @relation(fields: [automationId], references: [id], onDelete: SetNull)

  @@index([instagramAccountId, recipientExternalId, sentAt])
  @@index([sentAt])
}

/// A contact detail a person chose to share, with the proof: the wording they
/// were shown, when they tapped, and the message that carried it. One row per
/// tap; a retried webhook finds the same message id and writes nothing new.
model ContactConsent {
  id              String            @id @default(cuid())
  workspaceId     String
  contactId       String
  automationId    String?
  kind            ContactDetailKind
  value           String
  consentText     String
  consentedAt     DateTime
  /// The platform's id for the message the tap arrived as.
  sourceMessageId String
  createdAt       DateTime          @default(now())

  contact    Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  automation Automation? @relation(fields: [automationId], references: [id], onDelete: SetNull)

  @@unique([contactId, sourceMessageId])
  @@index([workspaceId, consentedAt])
}

/// A data deletion request a platform sent on a person's behalf, after they
/// removed the app. The confirmation code is what the platform shows them, and
/// the status page looks it up. The person's id is stored only as a hash: the
/// point of the request is that we stop holding it. Kept for a year.
model DataDeletionRequest {
  id               String          @id @default(cuid())
  confirmationCode String          @unique
  platform         ChannelPlatform
  /// SHA-256 of the platform's app-scoped user id.
  userIdHash       String
  accountsDeleted  Int             @default(0)
  requestedAt      DateTime        @default(now())
  completedAt      DateTime?

  @@index([requestedAt])
}

/// One write made through the v1 API with an Idempotency-Key, and the answer
/// it got. A retry with the same key and the same request is answered from
/// here instead of running again, so a dropped connection never creates a
/// campaign twice or sends a message twice. Keyed per credential, so two
/// integrations choosing the same key never collide. Kept for 24 hours.
model IdempotencyRecord {
  id           String    @id @default(cuid())
  /// The credential's rate limit identity, such as key:<id>. Never the secret.
  credentialId String
  key          String
  method       String
  path         String
  /// SHA-256 of the method, path and body, so the same key on a different
  /// request is refused rather than answered with the wrong reply.
  requestHash  String
  /// Null while the first request is still running.
  status       Int?
  body         String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  @@unique([credentialId, key])
  @@index([createdAt])
}

enum UsageKind {
  /// A message the engine sent: a private reply, a DM, a button reveal, an
  /// inbox reply or one sent through the API.
  MESSAGE_SENT
  /// A public reply posted under a comment.
  PUBLIC_REPLY
  /// A reply a model wrote, with what the provider charged for it.
  AI_REPLY
}

/// What a workspace used, per day, platform and kind. The counter a partner
/// bills its own users from. Kept as running daily totals rather than one row
/// per message, so it outlives the 90 day log retention at a few rows a day.
/// Money is in millionths of a dollar, as integers.
model UsageDaily {
  id                String          @id @default(cuid())
  workspaceId       String
  day               DateTime        @db.Date
  platform          ChannelPlatform
  kind              UsageKind
  count             Int             @default(0)
  /// What the model provider charged, for AI_REPLY.
  costMicros        BigInt          @default(0)
  /// What the platform charges per message, where it does (WhatsApp). Zero
  /// for Instagram and Facebook, which charge nothing.
  platformFeeMicros BigInt          @default(0)
  updatedAt         DateTime        @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, day, platform, kind])
  @@index([workspaceId, day])
}
